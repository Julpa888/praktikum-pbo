class AkunBank:

    def __init__(self, nama, saldo):
        self.nama = nama
        self.saldo = saldo

class Tabungan(AkunBank):
    def __init__(self, nama, saldo):
        super().__init__(nama, saldo)

akun_bank = [AkunBank("eko", 100), Tabungan("dapa", 100)]

for akun in akun_bank:
    if isinstance(akun, AkunBank):
        print("Ada objek Akun Bank")
    elif isinstance(akun, Tabungan):
        print("Ada objek Tabungan")
